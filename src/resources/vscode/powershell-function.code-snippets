{
    "PowerShell Function with Best Practices": {
        "prefix": "psfunction",
        "body": [
            "function ${1:Verb-Noun} {",
            "    <#",
            "    .SYNOPSIS",
            "        ${2:Brief description of the function}",
            "",
            "    .DESCRIPTION",
            "        ${3:Detailed description of what the function does}",
            "",
            "    .PARAMETER ${4:ParameterName}",
            "        ${5:Description of the parameter}",
            "",
            "    .EXAMPLE",
            "        ${6:Verb-Noun} -${7:ParameterName} \"${8:Value}\"",
            "",
            "        ${9:Description of what this example does}",
            "",
            "    .EXAMPLE",
            "        ${10:Verb-Noun} -${11:ParameterName} \"${12:AnotherValue}\"",
            "",
            "        ${13:Description of second example}",
            "",
            "    .INPUTS",
            "        ${14:System.String}",
            "",
            "        ${15:Description of inputs}",
            "",
            "    .OUTPUTS",
            "        ${16:System.Object}",
            "",
            "        ${17:Description of outputs}",
            "",
            "    .NOTES",
            "    #>",
            "",
            "    [CmdletBinding(",
            "        SupportsShouldProcess = $${18:true},",
            "        ConfirmImpact = '${19|Low,Medium,High|}',",
            "        DefaultParameterSetName = '${20:Default}'",
            "    )]",
            "    [OutputType([${21:System.Object}])]",
            "    param (",
            "        [Parameter(",
            "            Mandatory = $${22:true},",
            "            Position = ${23:0},",
            "            ValueFromPipeline = $${24:false},",
            "            ValueFromPipelineByPropertyName = $${25:false},",
            "            HelpMessage = '${26:Help message for parameter}'",
            "        )]",
            "        [ValidateNotNullOrEmpty()]",
            "        [${27|string,int,bool,object|}] $${4:ParameterName}${28:}",
            "",
            "        ${29:# Additional parameters}",
            "    )",
            "",
            "    begin {",
            "        Write-Verbose \"Starting \\$(\\$MyInvocation.MyCommand.Name)\"",
            "        ${30:# Initialization code}",
            "    }",
            "",
            "    process {",
            "        try {",
            "            if (\\$PSCmdlet.ShouldProcess(\"$${4:ParameterName}\", '${31:Action description}')) {",
            "                ${32:# Main function logic here}",
            "                Write-Verbose \"Processing: $${4:ParameterName}\"",
            "",
            "                ${33:# Return result}",
            "                return $${34:result}",
            "            }",
            "        } catch {",
            "            \\$PSCmdlet.ThrowTerminatingError(\\$_)",
            "        }",
            "    }",
            "",
            "    end {",
            "        Write-Verbose \"Completed \\$(\\$MyInvocation.MyCommand.Name)\"",
            "        ${35:# Cleanup code}",
            "    }",
            "}"
        ],
        "description": "Creates a full PowerShell advanced function template for operations that support ShouldProcess and WhatIf"
    },
    "PowerShell Advanced Function (Minimal)": {
        "prefix": "psfunc",
        "body": [
            "function ${1:Verb-Noun} {",
            "    <#",
            "    .SYNOPSIS",
            "        ${2:Brief description}",
            "",
            "    .DESCRIPTION",
            "        ${3:Detailed description of what the function does}",
            "",
            "    .PARAMETER ${4:ParameterName}",
            "        ${5:Parameter description}",
            "",
            "    .EXAMPLE",
            "        ${6:Verb-Noun} -${7:ParameterName} \"${8:Value}\"",
            "",
            "        ${9:Example description}",
            "",
            "    .OUTPUTS",
            "        ${10:System.Object}",
            "",
            "        ${11:Description of outputs}",
            "    #>",
            "",
            "    [CmdletBinding()]",
            "    [OutputType([${12:System.Object}])]",
            "    param (",
            "        [Parameter(Mandatory = $${13:true})]",
            "        [ValidateNotNullOrEmpty()]",
            "        [${14|string,int,bool,object|}] $${4:ParameterName}",
            "    )",
            "",
            "    begin {",
            "        ${15:# Initialization code}",
            "    }",
            "",
            "    process {",
            "        try {",
            "            ${16:# Function logic here}",
            "        } catch {",
            "            \\$PSCmdlet.ThrowTerminatingError(\\$_)",
            "        }",
            "    }",
            "",
            "    end {",
            "        ${17:# Cleanup code}",
            "    }",
            "}"
        ],
        "description": "Creates a minimal PowerShell advanced function for non-mutating or simple logic"
    }
}
